# .env.example — à copier en .env.local (JAMAIS committé) et dans les variables de
# l'hôte (Vercel). Aucune valeur réelle ici.

# ── Base de données (Neon) ───────────────────────────────────────────────────
# Postgres serverless. Les migrations s'appliquent AU DÉMARRAGE de l'app
# (lib/migrations.ts) : aucune commande à lancer, jamais, ni en local ni sur Vercel.
# Absent → l'app affiche « base non configurée » et n'invente aucune donnée.
DATABASE_URL=

# ── Intégration hub ──────────────────────────────────────────────────────────
# Jeton partagé avec le hub, envoyé par lui dans le header x-hub-token.
#   absent   → GET /hub/summary répond 503 (intégration désactivée, pas une panne)
#   invalide → 401 (échec fermé)
# La MÊME valeur doit être posée ici et dans HUB_TOKEN_CARAI côté Hubperso.
# Générer : node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
HUB_TOKEN=

# ── Authentification (Auth.js v5) — app PRIVÉE, une seule adresse ────────────
# Sans AUTH_SECRET **et** AUTHORIZED_EMAIL, le middleware refuse TOUT ce qui est
# protégé (503). C'est voulu : Auth.js seul se contente de logguer MissingSecret et
# LAISSE PASSER — une app privée ne doit jamais échouer ouvert.
# Générer AUTH_SECRET : npx auth secret   (ou openssl rand -base64 32)
AUTH_SECRET=
# L'UNIQUE adresse Google admise.
AUTHORIZED_EMAIL=

# Client OAuth Google « Web application ». Redirect URIs à déclarer côté Google :
#   http://localhost:3000/api/auth/callback/google
#   https://carai.hubperso.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Smartcar (source PRINCIPALE, Doc 2) ──────────────────────────────────────
# Onglet « API Credentials » du tableau de bord Smartcar. Le secret ne sort JAMAIS
# du serveur. Absents → CarAI affiche « véhicule non connecté », sans rien inventer.
SMARTCAR_CLIENT_ID=
SMARTCAR_CLIENT_SECRET=

# ⚠️ Identifiant du flow CONNECT — souvent DIFFÉRENT de SMARTCAR_CLIENT_ID.
# Smartcar a deux couches (Doc 2 §3.1) : les API Credentials M2M pour les appels serveur
# (format « client_… » + ULID), et l'application côté Connect (format UUID).
# Utiliser la première pour le Connect donne :
#     400: Invalid parameter client_id: client_01KZ9…
# Laisse cette variable VIDE si une seule valeur suffit chez toi : le code retombe alors
# sur SMARTCAR_CLIENT_ID. Renseigne-la avec l'UUID de l'application si le Connect refuse.
# SMARTCAR_CONNECT_CLIENT_ID=

# Token de MANAGEMENT : c'est la clé qui signe les webhooks (HMAC-SHA256 du corps brut).
# Absent → /api/webhooks/smartcar répond 503 et REFUSE toute livraison. Échec fermé
# volontaire : un webhook non vérifié est une porte ouverte en écriture sur la base.
SMARTCAR_MANAGEMENT_TOKEN=

# URL de redirection déclarée dans le tableau de bord Smartcar. Par défaut, CarAI
# utilise <origine>/api/connect/callback — ne renseigner que si elle diffère.
# SMARTCAR_REDIRECT_URI=https://carai.hubperso.com/api/connect/callback

# Mode du flow Connect : « live » par défaut. Mettre « test » pour un véhicule simulé.
# SMARTCAR_MODE=live

# ── Planificateur (poll Toyota) ──────────────────────────────────────────────
# Secret que Vercel envoie en Authorization: Bearer sur /api/cron/toyota-poll.
# Absent → la route répond 503 plutôt que d'accepter n'importe quel appel.
CRON_SECRET=

# ── Toyota, source COMPLÉMENTAIRE et non officielle (Doc 3) ──────────────────
# ⚠️ DÉSACTIVÉE PAR DÉFAUT, et ce n'est pas un oubli. Le Doc 3 §2 conditionne
# l'activation à deux vérifications que toi seul peux faire :
#   1. l'abonnement Toyota Connected Services est ACTIF sur ton compte (onglet
#      abonnements de l'app Toyota — pas seulement « l'app est installée ») ;
#   2. un compte toyota.ca fonctionne réellement avec cette bibliothèque. Personne
#      ne l'a confirmé publiquement : c'est un vrai inconnu technique, pas une
#      formalité.
# Tant que TOYOTA_NA_ENABLED n'est pas « true », rien de ce module ne s'exécute.
# CarAI fonctionne normalement sur Smartcar seul — c'est le principe d'isolation.
# TOYOTA_NA_ENABLED=true

# Identifiants du compte Toyota. Stockés chiffrés par l'hébergeur, jamais en base,
# jamais exposés au navigateur.
# TOYOTA_USERNAME=
# TOYOTA_PASSWORD=

# Secret partagé avec le service de courriel entrant qui pousse les codes de
# vérification Toyota vers /api/webhooks/toyota-otp (Resend Inbound ou équivalent).
# Absent → la route répond 503. Sans lui, n'importe qui pourrait injecter des codes
# dans la file et bloquer les connexions.
# TOYOTA_OTP_WEBHOOK_SECRET=

# ── Optionnel ────────────────────────────────────────────────────────────────
# URL du hub, pour un lien « ← Hub » dans l'en-tête (défaut : https://hubperso.com).
# NEXT_PUBLIC_HUB_URL=https://hubperso.com
