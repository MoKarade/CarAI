# .env.example — à copier en .env.local (JAMAIS committé) et dans les variables de
# l'hôte (Vercel, etc.). Aucune valeur réelle ici.

# ── Intégration hub ──────────────────────────────────────────────────────────
# Jeton partagé avec le hub, envoyé par lui dans le header x-hub-token.
#   absent   → GET /hub/summary répond 503 (intégration désactivée, pas une panne)
#   invalide → 401 (échec fermé)
# La MÊME valeur doit être posée ici et dans HUB_TOKEN_<ID> côté Hubperso.
# Générer : node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
HUB_TOKEN=

# ── Authentification (Auth.js v5) — app PRIVÉE, une seule adresse ────────────
# Sans AUTH_SECRET **et** AUTHORIZED_EMAIL, le middleware refuse TOUT ce qui est
# protégé (503). C'est voulu : Auth.js seul se contente de logguer MissingSecret et
# LAISSE PASSER — une app privée ne doit jamais échouer ouvert.
# Générer AUTH_SECRET : npx auth secret   (ou openssl rand -base64 32)
AUTH_SECRET=
# L'UNIQUE adresse Google admise.
AUTHORIZED_EMAIL=

# Client OAuth Google « Web application ». Redirect URIs à déclarer côté Google :
#   http://localhost:3000/api/auth/callback/google
#   https://<ton-app>.hubperso.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Optionnel ────────────────────────────────────────────────────────────────
# URL du hub, pour un lien « ← Hub » dans l'en-tête (défaut : https://hubperso.com).
# NEXT_PUBLIC_HUB_URL=https://hubperso.com
